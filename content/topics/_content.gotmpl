{{/* Content adapter: one page per topic in data/covers.yaml (/topics/<name>/).
   The posts listed on each page are worked out at render time (layouts/topics/single.html),
   so new posts appear under their topic without any front matter.
   build.list = "local" keeps these navigation pages out of site-wide collections (main RSS feed, sitemap);
   excludeFromSearch keeps them out of the search index. */}}
{{ range hugo.Data.covers.topics }}
  {{ $.AddPage (dict
    "path" .name
    "title" .label
    "kind" "page"
    "build" (dict "list" "local" "render" "always" "publishResources" true)
    "params" (dict "topic" .name "featureimage" (printf "img/covers/%s.svg" .name) "excludeFromSearch" true "showDate" false "showReadingTime" false "showTableOfContents" false)
    "content" (dict "mediaType" "text/markdown" "value" "")
  ) }}
{{ end }}
