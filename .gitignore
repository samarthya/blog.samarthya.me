/LOCAL-README.md
/notes/

# local tool settings (per machine)
/.claude/settings.local.json

# Secrets, just in case
.env
.env.*

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# Python venv for tools/
/tools/.venv/
__pycache__/

# review folder: files moved aside for review; delete after review
/to_be_deleted/
/TODO.md
/PUBLISHING.md
