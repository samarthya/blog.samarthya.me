{{- /* /latest.json: the newest posts as a small public feed, used by the portfolio (samarthya.github.io)
   to show "latest blogs". Each item has a ready-sized card image and its topic.
   Output format "Latest" is declared in config/_default/hugo.toml. */ -}}
{{- $items := slice -}}
{{- range first 9 (where site.RegularPages "Section" "posts").ByDate.Reverse -}}
  {{- $p := . -}}
  {{- $img := "" -}}
  {{- with partial "functions/feature-image.html" $p -}}
    {{- $r := or ($p.Resources.Get .) (resources.Get .) -}}
    {{- with $r -}}
      {{- if eq .MediaType.SubType "svg" -}}{{- $img = .Permalink -}}
      {{- else -}}{{- with try (.Fill "600x400 Center") -}}{{- with .Value -}}{{- $img = .Permalink -}}{{- end -}}{{- end -}}{{- end -}}
    {{- end -}}
  {{- end -}}
  {{- $topic := partial "functions/topic.html" $p -}}
  {{- $items = $items | append (dict
      "title" $p.Title
      "url" $p.Permalink
      "date" ($p.Date.Format "2006-01-02")
      "summary" ($p.Description | default ($p.Summary | plainify | htmlUnescape) | truncate 180)
      "topic" (cond (reflect.IsMap $topic) $topic.label "Notes")
      "image" $img) -}}
{{- end -}}
{{- dict "site" site.Title "url" site.Home.Permalink "updated" (now.UTC.Format "2006-01-02T15:04:05Z") "posts" $items | jsonify (dict "indent" "  ") -}}
