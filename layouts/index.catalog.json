{{- /* /catalog.json: every post and daily entry with the facts the about.samarthya.me stats site needs.
   GA4 reports page paths; this file maps a path (or an old /wps/ alias) to a title, image and topic.
   Public data only: nothing here that the HTML pages don't already show.
   Output format "Catalog" is declared in config/_default/hugo.toml. */ -}}
{{- $items := slice -}}
{{- range (where site.RegularPages "Section" "in" (slice "posts" "daily")).ByDate.Reverse -}}
  {{- $p := . -}}
  {{- $img := "" -}}
  {{- with partial "functions/feature-image.html" $p -}}
    {{- $r := or ($p.Resources.Get .) (resources.Get .) -}}
    {{- with $r -}}
      {{- if eq .MediaType.SubType "svg" -}}{{- $img = .Permalink -}}
      {{- else -}}{{- with try (.Fill "600x400 Center") -}}{{- with .Value -}}{{- $img = .Permalink -}}{{- end -}}{{- end -}}{{- end -}}
    {{- end -}}
  {{- end -}}
  {{- $topic := partial "functions/topic.html" $p -}}
  {{- $raw := $p.RawContent -}}
  {{- $items = $items | append (dict
      "title" $p.Title
      "url" $p.Permalink
      "path" $p.RelPermalink
      "aliases" ($p.Aliases | default slice)
      "section" $p.Section
      "date" ($p.Date.Format "2006-01-02")
      "lastmod" ($p.Lastmod.Format "2006-01-02")
      "topic" (cond (reflect.IsMap $topic) $topic.label "Notes")
      "tags" ($p.Params.tags | default slice)
      "words" $p.WordCount
      "readingMinutes" $p.ReadingTime
      "hasCode" (or (strings.Contains $raw "```") (strings.Contains $raw "~~~") (strings.Contains $raw "{{< highlight"))
      "image" $img) -}}
{{- end -}}
{{- dict "site" site.Title "url" site.Home.Permalink "updated" (now.UTC.Format "2006-01-02T15:04:05Z") "count" (len $items) "items" $items | jsonify (dict "indent" "  ") -}}
